.layout-sider
  position relative
  box-sizing border-box
  background-color var(--color-bg-2)
  flex none
  height 100%

  ::-webkit-scrollbar
    width 12px
    height 4px

  ::-webkit-scrollbar-thumb
    border 4px solid transparent
    background-clip padding-box
    border-radius 7px
    background-color var(--color-text-4)

  ::-webkit-scrollbar-thumb:hover
    background-color var(--color-text-3)

  &::after
    content ''
    display block
    position absolute
    top 0
    right -1px
    width 1px
    height 100%
    background-color var(--color-border)

  // 侧栏自身固定不滚，菜单在 .menu-wrapper 内滚；
  // 放开 sider-children 的裁剪，右凸的折叠把手才不会被切掉。
  > :global(.arco-layout-sider-children)
    height 100%
    overflow visible

  // 折叠把手：垂直居中贴在侧栏右边缘，整体向右凸出到内容区；
  // 左端与侧栏等高、右端上下各收进 18%，右端是竖直平边（梯形，不是尖角）。
  // 箭头方向由状态类控制：展开态 <（点击收起），收起后翻转成 >（点击展开）。
  .collapse-btn
    position absolute
    top 50%
    right -16px
    z-index 2
    width 16px
    height 60px
    display flex
    justify-content center
    align-items center
    background-color var(--color-fill-3)
    color var(--color-text-3)
    cursor pointer
    transform translateY(-50%)
    clip-path unquote('polygon(0 0, 100% 18%, 100% 82%, 0 100%)')

    // 右竖边与 aside 的 ::after 同色同宽，两条竖线把把手框成一个整体。
    &::after
      content ''
      display block
      position absolute
      top 18%
      right 0
      width 1px
      height 64%
      background-color var(--color-border)

    &:hover
      color var(--color-text-2)
      background-color var(--color-border)

    & :global(svg)
      transition transform 0.2s

    &.is-collapsed :global(svg)
      transform rotate(180deg)

.menu-wrapper
  overflow auto
  height 100%

  :global(.arco-menu-item-inner > a::after), :global(.arco-menu-item > a::after)
    content ''
    display block
    position absolute
    width 100%
    height 100%
    left 0
    right 0
    top 0
    bottom 0

  :global(.arco-menu-inline-header)
    font-weight 500
