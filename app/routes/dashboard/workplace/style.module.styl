.left
  width calc(100% - 296px)
  margin-right 16px

.right
  width 280px

.caret-green
  color s('rgb(var(--green-6))')

.caret-red
  color s('rgb(var(--red-6))')

// Overview 统计项
.stat
  &-item
    display flex
    align-items center
    padding-left 20px
    color var(--color-text-1)

  &-icon
    display flex
    align-items center
    justify-content center
    width 54px
    height 54px
    background-color var(--color-fill-2)
    border-radius 50%
    margin-right 12px

    :global
      .arco-icon
        width 50%
        height 50%

  &-title
    font-size 12px
    color var(--color-text-1)

  &-count
    font-size 22px
    font-weight 600
    color var(--color-text-1)

  &-unit
    font-size 12px
    font-weight 400
    color var(--color-text-2)
    margin-left 8px

.chart
  &-header
    display flex
    justify-content space-between
    margin-bottom 16px

  &-sub-title
    font-size 12px
    font-weight 400
    margin-left 4px
    color var(--color-text-3)

// Overview
.growth-icon
  font-size 18px
  color s('rgb(var(--green-6))')

// Shortcuts
.shortcut
  &-list
    display grid
    grid-template-columns 33.33% 33.33% 33.33%

  &-item
    display flex
    flex-direction column
    align-items center
    justify-content center
    padding 12px
    box-sizing border-box
    cursor pointer

    ^[1]:hover ^[0]-icon
      background-color var(--color-primary-light-1)

      svg
        color s('rgb(var(--primary-6))')

    ^[1]:hover ^[0]-title
      color s('rgb(var(--primary-6))')

  &-icon
    display flex
    justify-content center
    align-items center
    width 32px
    height 32px
    border-radius 6px
    background-color var(--color-fill-2)
    margin-bottom 4px

    svg
      font-size 18px

  &-title
    font-size 12px
    line-height 20px
    color var(--color-text-1)

.recent
  font-weight 500
  font-size 16px
  line-height 24px
  color var(--color-text-1)
  margin-bottom 16px

// Carousel
.carousel
  width 100%
  height 160px

  &-img
    width 280px
    transform translateY(-30px)

// Announcement
.announcement
  &-item
    display flex
    align-items center
    width 100%
    height 24px
    margin-bottom 4px

  &-text
    flex 1
    overflow hidden
    text-overflow ellipsis
    white-space nowrap
    margin-left 4px
    color var(--color-text-2)
    text-decoration none
    font-size 13px
    cursor pointer

// Docs
.docs
  display grid
  grid-template-columns 50% 50%

.doc-link
  color var(--color-text-2)
  padding 4px
  box-sizing border-box
  margin-bottom 12px

  &:hover
    color s('rgb(var(--primary-6))')
