.wrapper
  margin-top 16px

  :global(.arco-row)
    align-items stretch

  :global(.arco-col)
    display flex
    flex-direction column

.card
  display flex
  flex 1
  box-sizing border-box
  height 100%
  padding 20px
  padding-top 16px
  border-radius 4px
  min-height 100px

  &-line
    background linear-gradient(180deg, rgb(242 249 254) 0%, #e6f4fe 100%)

  &-interval
    background linear-gradient(180deg, rgb(245 254 242) 0%, rgb(230 254 238) 100%)

  &-pie
    background linear-gradient(180deg, rgb(247 247 255) 0%, rgb(236 236 255) 100%)

  :global(.arco-statistic-content)
    margin-top 24px
    margin-bottom 4px

    :global(.arco-statistic-value)
      font-size 24px
      line-height 28px

  .compare-yesterday-text
    font-size 12px
    font-weight 400
    color var(--color-text-2)

  .diff
    margin-left 8px
    line-height 20px
    color s('rgb(var(--red-6))')

  .diff-increment
    color s('rgb(var(--green-6))')

body[arco-theme='dark']
  .card
    &-line
      background linear-gradient(180deg, #284991 0%, #122b62 100%)

    &-pie
      background linear-gradient(180deg, #312565 0%, #201936 100%)

    &-interval
      background linear-gradient(180deg, #3d492e 0%, #263827 100%)
