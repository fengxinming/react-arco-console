.header
  height 200px
  display flex
  justify-content center
  align-items center
  color var(--color-text-1)
  border-radius 4px
  position relative

  :global(.arco-avatar-trigger-icon-button)
    color s('rgb(var(--arcoblue-6))')

    :global(.arco-icon)
      vertical-align -1px

  .user-msg
    line-height 20px

    &-text
      display inline-block
      margin-left 6px
      vertical-align middle

.header::after
  background url('./assets/header-banner.png') no-repeat
  background-size 100%
  height 200px
  width 100%
  position absolute
  top 0
  left 0
  opacity 0.4
  content ' '

.header-content
  position relative
  z-index 2

.project-wrapper
  cursor pointer

  :global
    .h6.arco-typography
      margin-top 0
      margin-bottom 6px
      font-size 14px

    .arco-typography-secondary
      font-size 12px
      margin-left 12px

.team-list
  :global
    .arco-list-content
      .arco-list-item
        padding 8px 0

        &:last-child
          padding-bottom 0

.news-list
  :global
    .arco-list-content
      .arco-list-item
        padding 24px 4px

        &:last-child
          padding-bottom 4px

  .list-meta-ellipsis
    :global(.arco-list-item-meta-content)
      width 0
      flex 1
